  "nodes": {
    "mem.complaint": {
      "section": "memory", "scale": "AD8", "scaleItem": "AD8_1",
      "intent": "Détecter une plainte mnésique subjective : le patient perçoit-il des problèmes de mémoire ?",
      "answerType": "yes_no",
      "options": [
        { "value": "yes", "label": "Oui", "score": 1, "finding": "memory loss" },
        { "value": "no",  "label": "Non", "score": 0 }
      ],
      "followUps": [
        { "id": "clarify.entourage", "intent": "La réponse est ambiguë : demander si l'entourage a remarqué ces oublis." }
      ],
      "branches": [
        { "when": { "answer": "yes" }, "next": "mem.duration" },
        { "when": { "answer": "no"  }, "next": "lang.wordfinding" }
      ],
      "defaultNext": "lang.wordfinding"
    },

    "mem.duration": {
      "section": "memory", "scale": "AD8", "scaleItem": "AD8_1b",
      "intent": "Préciser depuis combien de temps les troubles de mémoire sont présents.",
      "answerType": "single_choice",
      "options": [
        { "value": "lt6m",  "label": "Moins de 6 mois", "score": 0, "finding": "recent onset (< 6 months)" },
        { "value": "6_24m", "label": "Entre 6 mois et 2 ans", "score": 1, "finding": "symptoms present 6-24 months" },
        { "value": "gt2y",  "label": "Plus de 2 ans", "score": 1, "finding": "progressive symptoms for over 2 years",
          "redFlag": "troubles cognitifs évoluant depuis plus de 2 ans" }
      ],
      "branches": [ { "when": { "answer": "any" }, "next": "mem.worsening" } ],
      "defaultNext": "mem.worsening"
    },

    "mem.worsening": {
      "section": "memory", "scale": "AD8", "scaleItem": "AD8_2",
      "intent": "Savoir si les troubles de mémoire s'aggravent avec le temps.",
      "answerType": "yes_no",
      "options": [
        { "value": "yes", "label": "Oui, cela s'aggrave", "score": 1, "finding": "worsening memory decline",
          "redFlag": "aggravation progressive rapportée" },
        { "value": "no",  "label": "Non, c'est stable", "score": 0 }
      ],
      "branches": [ { "when": { "answer": "any" }, "next": "mem.appointments" } ],
      "defaultNext": "mem.appointments"
    },

    "mem.appointments": {
      "section": "memory", "scale": "AD8", "scaleItem": "AD8_3",
